# KlinikFlow — contoh konfigurasi untuk lab lokal.
# Salin ke .env lalu isi nilainya: cp .env.example .env
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).

# ── Database ──
# Password root hanya dipakai untuk inisialisasi container MySQL.
MYSQL_ROOT_PASSWORD=ganti-dengan-password-root-acak
MYSQL_DATABASE=klinikflow_db
MYSQL_USER=klinikflow_user
MYSQL_PASSWORD=ganti-dengan-password-acak

# ── Autentikasi ──
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
# Nilai yang sama dipakai bun-api dan php-api.
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# ── CORS ──
# Origin frontend yang boleh memanggil API (pisahkan dengan koma, tanpa spasi).
CORS_ORIGINS=http://localhost:8080

# ── Port host ──
WEB_PORT=8080
